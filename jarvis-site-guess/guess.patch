+.gs-t b{font:800 17px/1.15 var(--display);text-align:center;overflow-wrap:anywhere}
+.gs-t small{font:600 12px/1 var(--display);color:var(--ink-3);letter-spacing:.06em;text-transform:uppercase}
+.gs-em{width:44px;height:44px;object-fit:contain}
+.gs-t.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}
