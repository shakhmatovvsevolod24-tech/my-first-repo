+.gsp{--gs-model:#173daf}
+.gs-kpi{grid-template-columns:repeat(3,minmax(0,1fr));max-width:760px}
+.gs-kpi .mdl b{color:#8fb2ff}
+.gs-day{margin:clamp(22px,2.6vw,34px) 0 12px;font:800 22px/1.1 var(--display);text-transform:none;letter-spacing:0;display:flex;align-items:baseline;gap:10px}
+.gs-day:first-child{margin-top:0}
+.gs-day span{font:600 15px/1 var(--display);color:var(--ink-3)}
+.gs-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
+.gs-card{background:var(--card);border:1px solid var(--rule);border-radius:14px;padding:14px 16px 14px;display:grid;gap:12px;min-width:0}
+.gs-card header{display:flex;justify-content:space-between;gap:10px;font:600 14px/1 var(--display);color:var(--ink-2)}
+.gs-card header b{font-weight:800;color:var(--ink);letter-spacing:.04em}
+.gs-btns{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:8px;align-items:stretch}
